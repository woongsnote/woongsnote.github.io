---
import LinkItem from "../components/LinkItem.astro";
import { mainLinks } from "../data/links";
import Layout from "../layouts/Layout.astro";

const title = "문지웅 (@woongsnote)";
const description = "Frontend Developer · Personal links";
---

<Layout {title} {description}>
  <main class="page-shell">
    <article class="link-hub">
      <header class="profile">
        <img
          class="profile-image"
          src="/profile.png"
          alt="문지웅 프로필 사진"
          width="421"
          height="421"
          loading="eager"
          decoding="async"
        />
        <div class="profile-copy">
          <h1>문지웅</h1>
          <p class="handle">@woongsnote</p>
          <p class="role">Frontend Developer</p>
        </div>
      </header>

      <nav class="main-links" aria-label="주요 링크">
        {mainLinks.map((item) => <LinkItem {item} />)}
      </nav>

      <footer>
        <small>© {new Date().getFullYear()} woongsnote</small>
      </footer>
    </article>
  </main>
</Layout>
