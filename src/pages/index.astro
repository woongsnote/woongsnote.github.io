---
import { profile } from "../data/profile";
import Layout from "../layouts/Layout.astro";

const title = `${profile.name} (@${profile.username}) · Digital Business Card`;
const description = `${profile.tagline} · ${profile.bio}`;
const websiteLabel = new URL(profile.website).hostname.replace(/^www\./, "");
const githubLabel =
  new URL(profile.github).host + new URL(profile.github).pathname;
const contactLinks = [
  { label: "BLOG", text: websiteLabel, url: profile.website, external: true },
  { label: "GITHUB", text: githubLabel, url: profile.github, external: true },
  {
    label: "EMAIL",
    text: "Get in touch",
    url: `mailto:${profile.email}`,
    external: false,
  },
];
---

<Layout {title} {description}>
  <main class="page-shell">
    <div class="card-stage">
      <article class="business-card" aria-label={`${profile.name} 디지털 명함`}>
        <div class="card-turner" id="card-faces">
          <section
            class="card-face card-front"
            id="card-front"
            aria-label="Identity · 명함 앞면"
          >
            <span class="wordmark" aria-hidden="true">
              W.
            </span>
            <div class="identity">
              <h1 lang="en">{profile.displayName}</h1>
              <p lang="en">{profile.tagline}</p>
            </div>
            <p class="front-footer">{websiteLabel}</p>
          </section>
          <section
            class="card-face card-back"
            id="card-back"
            aria-labelledby="connect-heading"
          >
            <header class="back-header">
              <span class="wordmark" aria-hidden="true">
                W.
              </span>
              <span class="eyebrow" lang="en">
                CONNECT
              </span>
            </header>
            <div class="connect">
              <h2 id="connect-heading" lang="en">
                Where next.
              </h2>
              <nav class="contact-links" aria-label="주요 링크">
                {contactLinks.map((link) => (
                  <a
                    class="contact-link"
                    href={link.url}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    aria-label={
                      link.label === "EMAIL"
                        ? `${profile.email}로 이메일 보내기`
                        : `${link.label} · ${link.text} (새 탭)`
                    }
                  >
                    <span class="link-label" lang="en">
                      {link.label}
                    </span>
                    <span class="link-text" lang="en">
                      {link.text}
                    </span>
                  </a>
                ))}
              </nav>
            </div>
            <div class="contact-save">
              <img
                class="contact-qr"
                src="/contact-qr.svg"
                alt="연락처 저장용 QR 코드. 스캔하면 vCard 파일이 열립니다."
                width="111"
                height="111"
              />
              <a
                class="save-contact"
                href="/contact.vcf"
                download={`${profile.username}.vcf`}
                lang="en"
              >
                Save Contact
              </a>
            </div>
          </section>
        </div>
      </article>
      <div class="card-controls" aria-label="명함 컨트롤">
        <div class="rotation-control" hidden>
          <svg class="rotation-direction" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 8H4V4m0 4a8 8 0 1 1-1 7" />
          </svg>
          <button
            id="rotation-dial"
            class="rotation-dial"
            type="button"
            aria-controls="card-faces"
            aria-label="명함 회전 · 현재 앞면"
            aria-describedby="rotation-help"
          >
            <span class="dial-rotor" aria-hidden="true"></span>
          </button>
          <svg class="rotation-direction" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M16 8h4V4m0 4a8 8 0 1 0 1 7" />
          </svg>
        </div>
        <span id="rotation-help" class="sr-only">
          좌우로 드래그하거나 휠로 회전합니다. 좌우 방향키로 해당 방향의 다음 면으로 회전하고,
          Enter 또는 Space를 누르거나 탭하면 다음 면으로 회전합니다.
        </span>
        <button
          class="quiet-control"
          id="share-card"
          type="button"
          aria-label="명함 공유"
          data-url={profile.cardUrl}
          data-title={title}
          hidden
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 16V3m-4 4 4-4 4 4M5 12v8h14v-8" />
          </svg>
        </button>
      </div>
      <p
        id="share-status"
        class="share-status"
        role="status"
        aria-atomic="true"
      ></p>
      <div id="manual-copy" class="manual-copy" hidden>
        <label for="card-url">명함 주소</label>
        <input id="card-url" type="url" value={profile.cardUrl} readonly />
      </div>
    </div>
  </main>
</Layout>

<script>
  const card = document.querySelector<HTMLElement>(".business-card");
  const front = document.querySelector<HTMLElement>("#card-front");
  const back = document.querySelector<HTMLElement>("#card-back");
  const turner = document.querySelector<HTMLElement>("#card-faces");
  const dial = document.querySelector<HTMLButtonElement>("#rotation-dial");
  const rotationControl = document.querySelector<HTMLElement>(".rotation-control");

  if (card && front && back && turner && dial && rotationControl) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let angle = 0;
    let targetAngle = 0;
    let direction = 1;
    let animation = 0;
    let snapTimer = 0;
    let wheelMode: "continuous" | "stepped" | null = null;
    let suppressClick = false;
    let pointer: { id: number; x: number; y: number; angle: number; dragging: boolean } | null = null;

    const render = () => {
      turner.style.transform = `rotateY(${angle}deg)`;
      dial.style.setProperty("--dial-angle", `${angle}deg`);
    };

    const setFaceAccess = (moving: boolean) => {
      const backVisible = Math.cos((angle * Math.PI) / 180) < 0;
      // Move focus before making either face inert or aria-hidden.
      if (card.contains(document.activeElement)) dial.focus({ preventScroll: true });
      front.inert = moving || backVisible;
      back.inert = moving || !backVisible;
      front.setAttribute("aria-hidden", String(front.inert));
      back.setAttribute("aria-hidden", String(back.inert));
      dial.setAttribute(
        "aria-label",
        `명함 회전 · ${moving ? "회전 중" : `현재 ${backVisible ? "뒷면" : "앞면"}`}`,
      );
    };

    const stop = () => {
      window.clearTimeout(snapTimer);
      cancelAnimationFrame(animation);
      animation = 0;
    };

    const animateTo = (destination: number) => {
      stop();
      targetAngle = destination;
      if (reducedMotion.matches || Math.abs(destination - angle) < 0.01) {
        angle = destination;
        render();
        setFaceAccess(false);
        return;
      }
      setFaceAccess(true);
      const origin = angle;
      const started = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - started) / 480, 1);
        angle = origin + (destination - origin) * (1 - (1 - progress) ** 3);
        render();
        if (progress < 1) animation = requestAnimationFrame(tick);
        else {
          animation = 0;
          setFaceAccess(false);
        }
      };
      animation = requestAnimationFrame(tick);
    };

    const snap = () => {
      wheelMode = null;
      // Resolve exact half-turn ties in the last input direction, also below zero.
      const turns = angle / 180;
      const nearest = direction > 0 ? Math.floor(turns + 0.5) : Math.ceil(turns - 0.5);
      animateTo(nearest * 180);
    };

    const rotateBy = (delta: number) => {
      if (!delta) return;
      stop();
      direction = Math.sign(delta);
      angle += delta;
      targetAngle = angle;
      setFaceAccess(true);
      render();
    };

    const scheduleSnap = () => {
      window.clearTimeout(snapTimer);
      snapTimer = window.setTimeout(snap, 180);
    };

    const flip = (step = direction) => {
      wheelMode = null;
      direction = step;
      // Repeated taps advance the pending destination instead of resetting it.
      const turns = targetAngle / 180;
      const next = direction > 0 ? Math.floor(turns) + 1 : Math.ceil(turns) - 1;
      animateTo(next * 180);
    };

    setFaceAccess(false);
    render();
    card.classList.add("is-interactive");
    rotationControl.hidden = false;

    dial.addEventListener("click", (event) => {
      if (pointer || (suppressClick && event.detail !== 0)) return;
      flip();
    });
    dial.addEventListener("wheel", (event) => {
      if (event.ctrlKey || pointer) return;
      const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
      if (!delta) return;
      event.preventDefault();
      const magnitude = Math.abs(delta);
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? window.innerHeight : 1;
      // WheelEvent has no device identifier. Small/fractional input selects
      // continuous rotation for this gesture, including its larger later events.
      const fine = !Number.isInteger(delta) || magnitude < (event.deltaMode === 0 ? 40 : 1);
      if (fine || wheelMode === null) wheelMode = fine ? "continuous" : "stepped";
      const normalized = magnitude * unit * 0.6;
      // A detent must cross the 90-degree snap midpoint; cap large OS deltas.
      const degrees = wheelMode === "stepped"
        ? Math.min(150, Math.max(120, normalized))
        : Math.min(45, normalized);
      rotateBy(Math.sign(delta) * degrees);
      scheduleSnap();
    }, { passive: false });

    dial.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0 || pointer) return;
      suppressClick = false;
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY, angle, dragging: false };
      dial.setPointerCapture(event.pointerId);
    });
    dial.addEventListener("pointermove", (event) => {
      if (!pointer || pointer.id !== event.pointerId) return;
      const dx = event.clientX - pointer.x;
      const dy = event.clientY - pointer.y;
      if (!pointer.dragging) {
        if (Math.max(Math.abs(dx), Math.abs(dy)) < 6) return;
        // Leave vertical touch gestures to the page's native scrolling.
        if (Math.abs(dy) > Math.abs(dx)) {
          suppressClick = true;
          dial.releasePointerCapture(event.pointerId);
          pointer = null;
          return;
        }
        pointer.dragging = true;
        wheelMode = null;
        stop();
        pointer.angle = angle;
        dial.classList.add("is-dragging");
      }
      const next = pointer.angle + dx * 1.2;
      rotateBy(next - angle);
    });
    const endPointer = (event: PointerEvent) => {
      if (!pointer || pointer.id !== event.pointerId) return;
      const dragged = pointer.dragging;
      suppressClick = dragged || event.type !== "pointerup";
      pointer = null;
      dial.classList.remove("is-dragging");
      if (dial.hasPointerCapture(event.pointerId)) dial.releasePointerCapture(event.pointerId);
      if (dragged) snap();
    };
    dial.addEventListener("pointerup", endPointer);
    dial.addEventListener("pointercancel", endPointer);
    dial.addEventListener("lostpointercapture", endPointer);
    dial.addEventListener("keydown", (event) => {
      if (pointer) return;
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        flip(event.key === "ArrowRight" ? 1 : -1);
      }
    });
    reducedMotion.addEventListener("change", () => {
      if (animation) animateTo(targetAngle);
    });
    card.addEventListener("click", (event) => {
      const target = event.target;
      if (
        pointer || (front.inert && back.inert) || !(target instanceof Element) ||
        target.closest("a, button, input, label, .contact-save, .contact-qr")
      ) return;
      if (window.getSelection()?.toString()) return;
      flip();
    });
  }

  const shareButton = document.querySelector<HTMLButtonElement>("#share-card");
  const status = document.querySelector<HTMLParagraphElement>("#share-status");
  const manualCopy = document.querySelector<HTMLDivElement>("#manual-copy");
  const urlInput = document.querySelector<HTMLInputElement>("#card-url");

  if (shareButton && status && manualCopy && urlInput) {
    const url = shareButton.dataset.url;
    const title = shareButton.dataset.title;

    if (url && title) {
      shareButton.hidden = false;
      shareButton.addEventListener("click", async () => {
        shareButton.disabled = true;
        status.textContent = "";
        manualCopy.hidden = true;

        try {
          if (typeof navigator.share === "function") {
            try {
              await navigator.share({ title, url });
              status.textContent = "명함을 공유했습니다.";
              return;
            } catch (error) {
              if (error instanceof Error && error.name === "AbortError") {
                status.textContent = "공유를 취소했습니다.";
                return;
              }
            }
          }

          try {
            await navigator.clipboard.writeText(url);
            status.textContent = "명함 주소를 복사했습니다.";
          } catch {
            manualCopy.hidden = false;
            urlInput.focus();
            urlInput.select();
            status.textContent =
              "자동 복사가 되지 않았습니다. 아래 주소를 길게 누르거나 선택해 복사해 주세요.";
          }
        } finally {
          shareButton.disabled = false;
        }
      });
    }
  }
</script>
