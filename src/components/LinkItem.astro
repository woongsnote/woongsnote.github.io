---
import type { LinkItem as LinkItemData } from "../data/links";

interface Props {
  item: LinkItemData;
}

const { item } = Astro.props;
---

<a
  class="link-item"
  href={item.url}
  aria-label={item.ariaLabel}
  target={item.external ? "_blank" : undefined}
  rel={item.external ? "noopener noreferrer" : undefined}
>
  <span class="link-icon" aria-hidden="true">
    {item.icon === "blog" && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M6 4.75h8.75A3.25 3.25 0 0 1 18 8v11.25H9.25A3.25 3.25 0 0 1 6 16V4.75Z" />
        <path d="M6 16.25h8.25M9.5 8.5h5M9.5 11.5h4" />
      </svg>
    )}
    {item.icon === "github" && (
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.09 1.15A10.74 10.74 0 0 1 12 6.12c.96 0 1.91.13 2.81.38 2.15-1.46 3.09-1.15 3.09-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.04.76 2.1v3.13c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" />
      </svg>
    )}
    {item.icon === "email" && (
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="3.75" y="5.75" width="16.5" height="12.5" rx="2" />
        <path d="m5 7 7 5.25L19 7" />
      </svg>
    )}
  </span>
  <span class="link-copy">
    <span class="link-label">{item.label}</span>
    <span class="link-description">{item.description}</span>
  </span>
  <svg class="link-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path d="m7.5 5 5 5-5 5" />
  </svg>
</a>
